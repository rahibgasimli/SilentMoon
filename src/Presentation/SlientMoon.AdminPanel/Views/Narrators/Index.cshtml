@model SlientMoon.Application.DTOs.Common.PagedResult<SlientMoon.Application.DTOs.Narrators.NarratorListItemDto>

@{
    ViewData["Title"] = "Narrators";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Narrators</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni narrator</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Ada görə axtar..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-outline-secondary">Axtar</button>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Cins</th>
            <th>Track sayı</th>
            <th>Yaradılıb</th>
            <th>Əməliyyat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var narrator in Model.Data)
        {
            <tr>
                <td>@narrator.Name</td>
                <td>@narrator.Gender</td>
                <td>@narrator.TrackCount</td>
                <td>@narrator.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td style="width: 160px;">
                    <a asp-action="Edit" asp-route-id="@narrator.Id" class="btn btn-sm btn-outline-primary">Düzəliş et</a>
                    <form asp-action="Delete" asp-route-id="@narrator.Id" method="post" class="d-inline"
                          onsubmit="return confirm('&quot;@narrator.Name&quot; narrator-unu silmək istədiyinizə əminsiniz?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Meta.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.Meta.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Meta.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
