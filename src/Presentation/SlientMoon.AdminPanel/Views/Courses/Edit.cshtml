@model SlientMoon.AdminPanel.Models.Courses.EditCourseViewModel

@{
    ViewData["Title"] = "Kursu redaktə et";
}

<h1 class="h3 mb-4">Kursu redaktə et</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-en" type="button">EN</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-az" type="button">AZ</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ru" type="button">RU</button>
        </li>
    </ul>

    <div class="tab-content mb-4">
        <div class="tab-pane fade show active" id="tab-en">
            <div class="mb-3">
                <label asp-for="TitleEn" class="form-label">Başlıq (EN) *</label>
                <input asp-for="TitleEn" class="form-control" />
                <span asp-validation-for="TitleEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SubtitleEn" class="form-label">Alt başlıq (EN)</label>
                <input asp-for="SubtitleEn" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DescriptionEn" class="form-label">Təsvir (EN)</label>
                <textarea asp-for="DescriptionEn" class="form-control" rows="4"></textarea>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-az">
            <div class="mb-3">
                <label asp-for="TitleAz" class="form-label">Başlıq (AZ)</label>
                <input asp-for="TitleAz" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SubtitleAz" class="form-label">Alt başlıq (AZ)</label>
                <input asp-for="SubtitleAz" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DescriptionAz" class="form-label">Təsvir (AZ)</label>
                <textarea asp-for="DescriptionAz" class="form-control" rows="4"></textarea>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-ru">
            <div class="mb-3">
                <label asp-for="TitleRu" class="form-label">Başlıq (RU)</label>
                <input asp-for="TitleRu" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SubtitleRu" class="form-label">Alt başlıq (RU)</label>
                <input asp-for="SubtitleRu" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DescriptionRu" class="form-label">Təsvir (RU)</label>
                <textarea asp-for="DescriptionRu" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CategoryId" class="form-label">Kateqoriya *</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">— Seçin —</option>
                @foreach (var category in Model.CategoryOptions)
                {
                    <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="DurationSec" class="form-label">Müddət (saniyə) *</label>
            <input asp-for="DurationSec" type="number" class="form-control" />
            <span asp-validation-for="DurationSec" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsFeatured" class="form-check-input" />
                <label asp-for="IsFeatured" class="form-check-label">Seçilmiş kurs</label>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="ImageFile" class="form-label">Şəkil</label>
        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
        {
            <div class="text-muted small mb-2">Hazırkı: @Model.ExistingImageUrl</div>
        }
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
        <div class="form-text">Boş buraxsan, mövcud şəkil saxlanılacaq.</div>
    </div>

    <button type="submit" class="btn btn-primary">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-link">Ləğv et</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}