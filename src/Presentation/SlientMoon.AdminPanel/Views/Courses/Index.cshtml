@model SlientMoon.Application.DTOs.Common.PagedResult<SlientMoon.Application.DTOs.Admin.AdminCourseListItemDto>

@{
    ViewData["Title"] = "Kurslar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Kurslar</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni kurs</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Başlığa görə axtar..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-outline-secondary">Axtar</button>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Şəkil</th>
            <th>Başlıq</th>
            <th>Kateqoriya</th>
            <th>Müddət</th>
            <th>Baxış</th>
            <th>Seçilmiş</th>
            <th>Yaradılıb</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model.Data)
        {
            <tr>
                <td style="width: 60px;">
                    @if (!string.IsNullOrEmpty(course.ImageUrl))
                    {
                        <span class="text-muted small">@course.ImageUrl</span>
                    }
                </td>
                <td>
                    <div>@course.Title</div>
                    <div class="text-muted small">@course.Subtitle</div>
                </td>
                <td>@course.CategoryName</td>
                <td>@(course.DurationSec / 60) dəq</td>
                <td>@course.ViewCount</td>
                <td>@(course.IsFeatured ? "Bəli" : "Xeyr")</td>
                <td>@course.CreatedAt.ToString("dd.MM.yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Meta.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.Meta.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Meta.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}