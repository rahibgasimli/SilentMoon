@model SlientMoon.Application.DTOs.Common.PagedResult<SlientMoon.Application.DTOs.Admin.AdminTrackListItemDto>

@{
    ViewData["Title"] = "Tracklər";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Tracklər</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni track</a>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Başlığa görə axtar..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-outline-secondary">Axtar</button>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Başlıq</th>
            <th>Kurs</th>
            <th>Narrator</th>
            <th>Müddət</th>
            <th>Yaradılıb</th>
            <th>Əməliyyat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var track in Model.Data)
        {
            <tr>
                <td>@track.Title</td>
                <td>@track.CourseTitle</td>
                <td>@track.NarratorName</td>
                <td>@(track.DurationSec / 60) dəq</td>
                <td>@track.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td style="width: 160px;">
                    <a asp-action="Edit" asp-route-id="@track.Id" class="btn btn-sm btn-outline-primary">Düzəliş et</a>
                    <form asp-action="Delete" asp-route-id="@track.Id" method="post" class="d-inline"
                          onsubmit="return confirm('&quot;@track.Title&quot; trackini silmək istədiyinizə əminsiniz?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Meta.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.Meta.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Meta.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}