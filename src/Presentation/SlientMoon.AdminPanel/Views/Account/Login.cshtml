@model SlientMoon.AdminPanel.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <h1 class="login-title">SlientMoon Admin</h1>

    <div asp-validation-summary="All" class="alert alert-danger mb-3" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Parol</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Məni xatırla</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Daxil ol</button>
    </form>
</div>